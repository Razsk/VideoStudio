      "beat_name": "Catalyst",
      "heading": {
        "element_type": "scene_heading",
        "uuid": "de563ef3-a36c-4aaa-81b7-264cd4d141bb",
        "context": "INT",
        "setting": "Helios Deep-Space Observatory Dome",
        "time_of_day": "NIGHT",
        "lighting_lock": "Chiaroscuro",
        "color_palette_lock": "Teal & Orange"
      },
      "elements": [
        {
          "element_type": "action",
          "uuid": "66efbec6-d7c0-41d7-8aae-25b39c390c60",
          "description": "Sleet lashes the curved glass of the observatory dome. Commander Elena Vance rotates the brass azimuth vernier until the green CRT waveform stabilizes."
        },
        {
          "element_type": "character",
          "uuid": "7e24541e-0dd8-47c6-90a1-58efb37d5a66",
          "character_id": "CHAR_ELENA_VANCE",
          "name": "ELENA VANCE",
          "base_bible_anchor_key": "canon/bible/characters/CHAR_ELENA_VANCE"
        },
        {
          "element_type": "parenthetical",
          "uuid": "91541236-a58d-4bc8-8e93-158022ea3e3d",
          "micro_expression": "eyes fixed on the oscilloscope, jaw set",
          "emotional_cadence": "low, measured urgency"
        },
        {
          "element_type": "dialogue",
          "uuid": "f9398417-4b69-4e0f-a758-17ace469ee56",
          "character_id": "CHAR_ELENA_VANCE",
          "spoken_string": "That carrier wave is repeating on a seven-second harmonic. Unseal the Chrono-Compass.",
          "language_identifier": "en-US"
        },
        {
          "element_type": "action",
          "uuid": "dedd4d06-495a-4aed-ba9a-888aaa9f07bd",
          "description": "Dr. Marcus Koren steps into the amber console light, adjusting his titanium spectacles as he unlatches the brass compass casing."
        },
        {
          "element_type": "character",
          "uuid": "e46ff665-f9ac-4a4a-b245-e694a5cbe99f",
          "character_id": "CHAR_MARCUS_KOREN",
          "name": "DR. MARCUS KOREN",
          "base_bible_anchor_key": "canon/bible/characters/CHAR_MARCUS_KOREN"
        },
        {
          "element_type": "parenthetical",
          "uuid": "4d521ddd-e8d8-4e25-ba6a-a47ef1c48d5c",
          "micro_expression": "glancing toward the pressure bulkhead",
          "emotional_cadence": "guarded, hesitant"
        },
        {
          "element_type": "dialogue",
          "uuid": "0489b5d4-850e-4c49-a8ec-102bb44f03cb",
          "character_id": "CHAR_MARCUS_KOREN",
          "spoken_string": "If we route that harmonic through Sub-Level Four, the Directorate sensors will register the spike.",
          "language_identifier": "en-US"
        },
        {
          "element_type": "transition",
          "uuid": "95b3b445-bfa3-42ff-b816-8c9e3cb68a31",
          "transition_type": "CUT TO:"
        }
      ],
      "initial_state": {
        "relay_lock": "unlocked",
        "compass_state": "closed_on_belt",
        "vault_access": "sealed"
      },
      "terminal_state": {
        "relay_lock": "phase_locked",
        "compass_state": "opened_calibrated",
        "vault_access": "authorized"
      }
    },
    {
      "scene_id": "SC02",
      "uuid": "f50c0905-b0b0-4747-85b5-6ba1e4dc0dd5",
      "beat_name": "Midpoint",
      "heading": {
        "element_type": "scene_heading",
        "uuid": "3facffc0-ebb3-4224-85b8-295d29569bf1",
        "context": "INT",
        "setting": "Sub-Level 4 Cryogenic Relay Vault",
        "time_of_day": "NIGHT",
        "lighting_lock": "Volumetric Split",
