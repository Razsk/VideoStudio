      },
      "elements": [
        {
          "element_type": "action",
          "uuid": "86e0d2bf-8573-473d-b5ac-446319339b57",
          "description": "Cryogenic vapor pours across the grated basalt floor of the vault. Elena presses the opened Chrono-Compass into the recessed waveguide socket."
        },
        {
          "element_type": "character",
          "uuid": "0e84a1cc-e73c-48ca-bbcd-605bf416632f",
          "character_id": "CHAR_ELENA_VANCE",
          "name": "ELENA VANCE",
          "base_bible_anchor_key": "canon/bible/characters/CHAR_ELENA_VANCE"
        },
        {
          "element_type": "parenthetical",
          "uuid": "39dcbeff-f89b-4b27-b3fb-6df0f0def7d4",
          "micro_expression": "breath misting in the cold, brow furrowed",
          "emotional_cadence": "resolute"
        },
        {
          "element_type": "dialogue",
          "uuid": "eb3619a4-cecc-4745-b6c8-0862a9f1c21f",
          "character_id": "CHAR_ELENA_VANCE",
          "spoken_string": "The phase lock holds. Read me the origin coordinates before the frost blinds the primary optics.",
          "language_identifier": "en-US"
        },
        {
          "element_type": "action",
          "uuid": "b3b615ea-7b2f-433e-b958-60aff1c1716e",
          "description": "Sparks arc across the conduit manifold, leaving a scorch mark along Elena's right forearm sleeve as Koren braces the terminal."
        },
        {
          "element_type": "character",
          "uuid": "36b0e5f7-e07b-4026-8596-21640c7a1889",
          "character_id": "CHAR_MARCUS_KOREN",
          "name": "DR. MARCUS KOREN",
          "base_bible_anchor_key": "canon/bible/characters/CHAR_MARCUS_KOREN"
        },
        {
          "element_type": "parenthetical",
          "uuid": "371cb09f-2ccc-4c98-bdd1-f5b66a2ac84a",
          "micro_expression": "eyes widening behind fogged lenses",
          "emotional_cadence": "stunned realization"
        },
        {
          "element_type": "dialogue",
          "uuid": "b3bfc2ad-c5ad-430e-8a58-f9ea09dc59fc",
          "character_id": "CHAR_MARCUS_KOREN",
          "spoken_string": "It isn't an echo. Beacon Nine is broadcasting live from inside the Jovian shadow.",
          "language_identifier": "en-US"
        },
        {
          "element_type": "transition",
          "uuid": "7b88c87b-9f3c-4135-a429-e472332f8eb9",
          "transition_type": "DISSOLVE TO:"
        }
      ],
